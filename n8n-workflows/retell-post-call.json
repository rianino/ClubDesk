{
  "name": "Retell AI Post-Call Processor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "retell-post-call",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000001",
      "name": "Webhook - Post Call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 460],
      "webhookId": "retell-post-call"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body;\n\n// Extract call data from Retell webhook payload\nconst callId = payload.call_id || payload.call?.call_id || 'unknown';\nconst transcript = payload.transcript || payload.call?.transcript || '';\nconst duration = payload.call_duration_ms\n  ? Math.round(payload.call_duration_ms / 1000)\n  : payload.call?.duration_ms\n    ? Math.round(payload.call.duration_ms / 1000)\n    : 0;\n\nconst callerPhone = payload.from_number || payload.call?.from_number || 'Unknown';\nconst callerName = payload.caller_name || payload.call?.metadata?.caller_name || 'Unknown Caller';\nconst callerEmail = payload.caller_email || payload.call?.metadata?.caller_email || '';\nconst callStatus = payload.call_status || payload.call?.status || 'completed';\nconst callTimestamp = payload.start_timestamp\n  ? new Date(payload.start_timestamp).toISOString()\n  : new Date().toISOString();\n\n// Determine actions taken during the call\nconst toolCalls = payload.tool_calls || payload.call?.tool_calls || [];\nconst actionsTaken = toolCalls.map(tc => tc.tool_name || tc.name || 'unknown_action');\nconst rsvpMade = actionsTaken.includes('rsvp_guest');\nconst escalated = actionsTaken.includes('escalate');\n\n// Build a condensed transcript for summarization\nlet condensedTranscript = transcript;\nif (typeof transcript === 'object' && Array.isArray(transcript)) {\n  condensedTranscript = transcript\n    .map(entry => `${entry.role || 'unknown'}: ${entry.content || entry.text || ''}`)\n    .join('\\n');\n}\n\n// Truncate if too long for the API\nif (condensedTranscript.length > 4000) {\n  condensedTranscript = condensedTranscript.substring(0, 4000) + '\\n[transcript truncated]';\n}\n\nreturn [{\n  json: {\n    call_id: callId,\n    transcript: condensedTranscript,\n    duration_seconds: duration,\n    caller_phone: callerPhone,\n    caller_name: callerName,\n    caller_email: callerEmail,\n    call_status: callStatus,\n    call_timestamp: callTimestamp,\n    actions_taken: actionsTaken.join(', ') || 'none',\n    rsvp_made: rsvpMade,\n    escalated: escalated\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000002",
      "name": "Extract Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $credentials.httpHeaderAuth.value }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 256,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Summarize this phone call transcript in 1-2 concise sentences. Focus on the caller's intent and outcome. If no transcript is available, state that.\\n\\nTranscript:\\n{{ $json.transcript }}\\n\\nActions taken during call: {{ $json.actions_taken }}\"\n    }\n  ]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000003",
      "name": "Claude API - Summarize Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 460],
      "credentials": {
        "httpHeaderAuth": {
          "id": "anthropic-api-key-cred-id",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst prevData = $('Extract Call Data').first().json;\n\n// Extract summary from Claude API response\nlet summary = 'Summary unavailable';\nif (input.content && Array.isArray(input.content)) {\n  summary = input.content\n    .filter(block => block.type === 'text')\n    .map(block => block.text)\n    .join(' ');\n} else if (typeof input.content === 'string') {\n  summary = input.content;\n}\n\nreturn [{\n  json: {\n    ...prevData,\n    summary: summary\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000004",
      "name": "Merge Summary with Call Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 460]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Call Log",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.call_timestamp }}",
            "Call ID": "={{ $json.call_id }}",
            "Caller Name": "={{ $json.caller_name }}",
            "Caller Phone": "={{ $json.caller_phone }}",
            "Caller Email": "={{ $json.caller_email }}",
            "Duration (s)": "={{ $json.duration_seconds }}",
            "Summary": "={{ $json.summary }}",
            "Actions Taken": "={{ $json.actions_taken }}",
            "Status": "={{ $json.call_status }}"
          },
          "matchingColumns": ["Call ID"],
          "schema": [
            { "id": "Timestamp", "displayName": "Timestamp", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Call ID", "displayName": "Call ID", "required": false, "defaultMatch": true, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "Caller Name", "displayName": "Caller Name", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "Caller Phone", "displayName": "Caller Phone", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "Caller Email", "displayName": "Caller Email", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "Duration (s)", "displayName": "Duration (s)", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": false },
            { "id": "Summary", "displayName": "Summary", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "Actions Taken", "displayName": "Actions Taken", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "Status", "displayName": "Status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000005",
      "name": "Google Sheets - Log Call",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1260, 460],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-cred-id",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "rsvp-check",
              "leftValue": "={{ $json.rsvp_made }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            },
            {
              "id": "email-check",
              "leftValue": "={{ $json.caller_email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "name": "filter.operator.notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000006",
      "name": "IF - RSVP Was Made",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1520, 460]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.caller_email }}",
        "subject": "=RSVP Confirmation - {{ $json.caller_name }}",
        "emailType": "html",
        "message": "=<h2>Your RSVP Has Been Confirmed!</h2>\n<p>Hi {{ $json.caller_name }},</p>\n<p>Thank you for calling in. This email confirms that your RSVP has been successfully recorded.</p>\n<p><strong>Summary of your call:</strong><br>{{ $json.summary }}</p>\n<p>You should also receive a Google Calendar invitation shortly. If you have any questions, feel free to call us back or reply to this email.</p>\n<p>Best regards,<br>ClubDesk Auto-Agent</p>",
        "options": {
          "replyTo": "owner@clubdesk.example.com"
        }
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000007",
      "name": "Gmail - Send RSVP Confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1800, 360],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-cred-id",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    message: 'Post-call processing complete. No RSVP follow-up email needed.',\n    call_id: $json.call_id\n  }\n}];"
      },
      "id": "b2c3d4e5-2222-4bbb-cccc-000000000008",
      "name": "No Follow-Up Needed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 560]
    }
  ],
