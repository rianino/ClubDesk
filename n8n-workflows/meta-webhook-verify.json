      "webhookId": "meta-messenger-verify"
    },
    {
      "parameters": {
        "jsCode": "// Meta Webhook Verification\n// Meta sends a GET request with these query parameters:\n//   hub.mode, hub.verify_token, hub.challenge\n\nconst VERIFY_TOKEN = 'YOUR_META_VERIFY_TOKEN_HERE';\n\nconst query = $input.item.json.query;\nconst mode = query['hub.mode'];\nconst token = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\n\nif (mode === 'subscribe' && token === VERIFY_TOKEN) {\n  // Verification successful — return the challenge as plain text\n  return [{\n    json: {\n      responseStatusCode: 200,\n      challenge: challenge\n    }\n  }];\n} else {\n  // Verification failed\n  return [{\n    json: {\n      responseStatusCode: 403,\n      challenge: 'Forbidden: invalid verify token'\n    }\n  }];\n}\n"
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000002",
      "name": "Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": {
          "responseCode": "={{ $json.responseStatusCode }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/plain"
              }
            ]
          }
        }
      },
      "id": "a1b2c3d4-1111-4aaa-bbbb-000000000003",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
